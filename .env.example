# Copy this file to `.env.local` and fill in your key. `.env.local` is git-ignored.
#
#   copy .env.example .env.local        (Windows)
#   cp .env.example .env.local          (macOS / Linux)
#
# Get a FREE key, no credit card: https://aistudio.google.com/apikey  ->  "Create API key".
# IMPORTANT: do NOT rename this to VITE_GEMINI_API_KEY. Anything starting with
# VITE_ is bundled into the browser code and would leak your key to every visitor.
GEMINI_API_KEY=

# Optional. The default, gemini-flash-lite-latest, is the fast light model and always points at Google's current one.
# Once you have rehearsed your demo you can pin one (see https://ai.google.dev/gemini-api/docs/models).
# GEMINI_MODEL=gemini-flash-lite-latest

# Optional. Tried in order if the main model is busy or out of free quota (comma-separated).
# GEMINI_FALLBACK_MODELS=gemini-flash-latest
